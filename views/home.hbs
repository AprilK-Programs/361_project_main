<div class = "centerDiv">
    <h1>Zombie Shop Simulator</h1>
    <h2>Select New Game or Continue Game to begin:</h2>
    
    <form id='new_game' method ='POST' action ='/create/new'> 
            <button type='submit' onclick="return confirm('If you start a new game, old files will be deleted. Continue?')">
                New Game
            </button>
        </form>
    <form id='continue_game' method ='POST' action ='/gamehome/continue'> 
            <button type='submit' onclick="return confirm('Resume last playthrough?')">
                Continue Game
            </button>
        </form>
</div>